# =============================================================================
# MeetMatch AI - Unified .gitignore
# =============================================================================

# Environment variables (keep .env.example tracked)
.env
.env.*
!.env.example

# --- Python & Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# SQLite / Database
*.db
*.db-journal
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite

# Python testing & coverage
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --- Node.js & Frontend ---
node_modules/
jspm_packages/
web_modules/

# TypeScript cache
*.tsbuildinfo

# Vite & build output
frontend/dist/
dist/
.output/
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Frontend test coverage & logs
coverage/
*.lcov
.nyc_output/
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package managers
.npm
.eslintcache
.stylelintcache
.yarn-integrity
.pnpm-store

# --- IDE, Editors & OS ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~